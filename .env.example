# Local development — copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=salon_team
POSTGRES_USER=salon_team
POSTGRES_PASSWORD=salon_team_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Temporary local-only when Postgres is unavailable (not for production)
# USE_SQLITE=true
